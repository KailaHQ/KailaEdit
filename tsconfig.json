{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["frontend/*"],
      "@core/*": ["core/src/*"],
      "@kailaedit/core": ["core/src/index.ts"],
      "@kailaedit/core/*": ["core/src/*"],
      "@komfyedit/core": ["core/src/index.ts"],
      "@komfyedit/core/*": ["core/src/*"]
    }
  },
  "include": ["frontend", "shared", "core"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
