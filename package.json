{
  "name": "kailaedit",
  "productName": "KailaEdit",
  "version": "1.0.4",
  "description": "KailaEdit - Desktop Video Editor",
  "type": "module",
  "main": "dist-electron/main.js",
  "license": "Apache-2.0",
  "author": {
    "name": "KailaEdit",
    "email": "tuyenhm68@users.noreply.github.com"
  },
  "homepage": "https://github.com/tuyenhm68/KomfyEdit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuyenhm68/KomfyEdit.git"
  },
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "postinstall": "node scripts/patch-dev-icon.cjs",
    "predev": "node scripts/patch-dev-icon.cjs",
    "predev:debug": "node scripts/patch-dev-icon.cjs",
    "dev": "vite",
    "dev:debug": "cross-env ELECTRON_DEBUG=1 vite",
    "typecheck": "pnpm run typecheck:renderer && pnpm run typecheck:electron",
    "test": "vitest",
    "test:run": "vitest run",
    "build:frontend": "vite build",
    "build": "vite build && electron-builder",
    "build:dir": "vite build && electron-builder --dir",
    "release": "vite build && electron-builder --publish always",
    "changelog:draft": "node scripts/draft-changelog.mjs",
    "changelog:check": "node scripts/release-notes.cjs --check",
    "release:notes": "node scripts/release-notes.cjs",
    "start:unpacked:mac": "open release/mac-arm64/KailaEdit.app",
    "start:unpacked:win": "powershell -Command \"& '.\\release\\win-unpacked\\KailaEdit.exe'\"",
    "mcp": "node packages/kailaedit-mcp/bin/kailaedit-mcp.js",
    "eval:skills": "tsx scripts/eval-skills.ts",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@resvg/resvg-js": "2.6.2",
    "@xmldom/xmldom": "0.9.12",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.9",
    "ffmpeg-static": "5.3.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "4.7.2",
    "tailwind-merge": "^2.3.0",
    "zod": "4.3.6",
    "zustand": "5.0.12"
  },
  "optionalDependencies": {
    "@resvg/resvg-js-darwin-arm64": "2.6.2",
    "@resvg/resvg-js-darwin-x64": "2.6.2",
    "@resvg/resvg-js-linux-arm64-gnu": "2.6.2",
    "@resvg/resvg-js-linux-x64-gnu": "2.6.2",
    "@resvg/resvg-js-win32-x64-msvc": "2.6.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "happy-dom": "20.11.12",
    "postcss": "^8.4.38",
    "resedit": "3.1.0",
    "tailwindcss": "^3.4.4",
    "tsx": "4.23.12",
    "typescript": "^5.4.5",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "supportedArchitectures": {
      "cpu": [
        "x64",
        "arm64"
      ]
    },
    "onlyBuiltDependencies": [
      "electron",
      "ffmpeg-static"
    ],
    "overrides": {
      "minimatch": "^10.2.3",
      "rollup": "^4.59.0",
      "tar": "^7.5.11"
    }
  }
}
